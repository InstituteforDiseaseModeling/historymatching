   "source": [
    "# Observed data\n",
    "observations = pd.DataFrame({\n",
    "    'Times': [3, 15],\n",
    "    'Prevalence': [15, 40],\n",
    "    'Stdev': [4, 2.3],\n",
    "})\n",
    "print(observations)\n",
    "\n",
    "# For this first iteration, we're going to make one \"cut\" using the first observation, but \n",
    "# you can separately do multiple \"cuts\" per iteration using several obervations (separately)\n",
    "# We'll need a name for this cut and the desired results\n",
    "cut_name = 'First_Prevalence_Meas' # No spaces or strange characters!\n",
    "desired_result = observations.iloc[0]['Prevalence']\n",
    "desired_result_var = observations.iloc[0]['Stdev']**2"
