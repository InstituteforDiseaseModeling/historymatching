   "source": [
    "# Automatic History Matching Workflow\n",
    "\n",
    "This notebook demonstrates the fully automated history matching workflow using the new object-oriented API. We'll show how to set up and run complete multi-iteration workflows with minimal user intervention.\n",
    "\n",
    "## Overview\n",
    "\n",
    "The automatic workflow features:\n",
    "- **Automatic Feature Selection**: Algorithm chooses optimal features for emulation\n",
    "- **Multi-Iteration Execution**: Run complete workflows with a single command\n",
    "- **Convergence Detection**: Automatic stopping when parameter space is sufficiently constrained\n",
    "- **Progress Monitoring**: Built-in callbacks and progress tracking\n",
    "- **Adaptive Strategies**: Dynamic adjustment of parameters based on performance\n",
    "\n",
    "This is ideal for production workflows and large-scale parameter estimation problems."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import math\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import time\n",
    "from pathlib import Path\n",
    "\n",
    "# Import the history matching library\n",
    "import history_matching as hm\n",
    "\n",
    "%matplotlib inline\n",
    "np.random.seed(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Enhanced SIR Model with Rich Feature Set\n",
    "\n",
    "For automatic feature selection to be effective, we need a rich set of potential features."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class SIR:\n",
    "    \"\"\"Enhanced stochastic SIR model with comprehensive outputs.\"\"\"\n",
    "    \n",
    "    def __init__(self, beta=1.2, gamma=0.3, s0=990, i0=10, r0=0, \n",
    "                 n_days=25, step=0.1, seed=None):\n",
    "        # Input validation\n",
    "        assert beta > 0 and gamma > 0, \"Rates must be positive\"\n",
    "        assert s0 >= 0 and i0 >= 0 and r0 >= 0, \"Initial conditions must be non-negative\"\n",
    "        assert n_days > 0 and 0 < step <= 1, \"Invalid time parameters\"\n",
    "        \n",
    "        self.beta = beta\n",
    "        self.gamma = gamma\n",
    "        self.s0 = int(s0)\n",
    "        self.i0 = int(i0)\n",
    "        self.r0 = int(r0)\n",
    "        self.n_days = int(n_days)\n",
    "        self.step = step\n",
    "        self.seed = seed\n",
    "        self.simulation_complete = False\n",
    "    \n",
    "    def run(self):\n",
    "        \"\"\"Run the stochastic SIR simulation.\"\"\"\n",
    "        # Setup\n",
    "        n_steps = math.ceil((self.n_days - 1) / self.step)\n",
    "        steps_per_day = int(1 / self.step)\n",
    "        N = self.s0 + self.i0 + self.r0\n",
    "        \n",
    "        # Initialize arrays\n",
    "        s = np.zeros(n_steps + 1, dtype=int)\n",
    "        i = np.zeros(n_steps + 1, dtype=int)\n",
    "        r = np.zeros(n_steps + 1, dtype=int)\n",
    "        \n",
    "        s[0] = self.s0\n",
    "        i[0] = self.i0\n",
    "        r[0] = self.r0\n",
    "        \n",
    "        # Daily outputs\n",
    "        s_daily = np.zeros(self.n_days, dtype=int)\n",
    "        i_daily = np.zeros(self.n_days, dtype=int)\n",
    "        r_daily = np.zeros(self.n_days, dtype=int)\n",
    "        \n",
    "        s_daily[0] = s[0]\n",
    "        i_daily[0] = i[0]\n",
    "        r_daily[0] = r[0]\n",
    "        \n",
    "        if self.seed is not None:\n",
    "            np.random.seed(self.seed)\n",
    "        \n",
    "        # Tau-leap simulation\n",
    "        for j in range(1, n_steps + 1):\n",
    "            # Calculate event rates\n",
    "            lambda_transmission = (self.beta * s[j-1] * i[j-1] / N) * self.step\n",
    "            lambda_recovery = self.gamma * i[j-1] * self.step\n",
    "            \n",
    "            # Sample events\n",
    "            delta_Mt = np.random.poisson(lambda_transmission)\n",
    "            delta_Mr = np.random.poisson(lambda_recovery)\n",
    "            \n",
    "            # Update states\n",
    "            s[j] = max(s[j-1] - delta_Mt, 0)\n",
    "            i[j] = max(i[j-1] + delta_Mt - delta_Mr, 0)\n",
    "            r[j] = r[j-1] + delta_Mr\n",
    "        \n",
    "        # Extract daily values\n",
    "        for j in range(1, self.n_days):\n",
    "            k = j * steps_per_day\n",
    "            s_daily[j] = s[k]\n",
    "            i_daily[j] = i[k]\n",
    "            r_daily[j] = r[k]\n",
    "        \n",
    "        self.s = s_daily\n",
    "        self.i = i_daily\n",
    "        self.r = r_daily\n",
    "        self.simulation_complete = True\n",
    "        \n",
    "        return s_daily, i_daily, r_daily\n",
    "    \n",
    "    def get_comprehensive_outputs(self):\n",
    "        \"\"\"Get comprehensive set of model outputs for automatic feature selection.\"\"\"\n",
    "        if not self.simulation_complete:\n",
    "            self.run()\n",
    "        \n",
    "        # Calculate incidence\n",
    "        incidence = np.zeros(len(self.i))\n",
    "        incidence[0] = 0\n",
    "        for j in range(1, len(self.i)):\n",
    "            incidence[j] = self.s[j-1] - self.s[j]\n",
    "        \n",
    "        # Calculate cumulative cases\n",
    "        cumulative_cases = np.cumsum(incidence)\n",
    "        \n",
    "        # Calculate prevalence\n",
    "        N = self.s0 + self.i0 + self.r0\n",
    "        prevalence = self.i / N\n",
    "        \n",
    "        outputs = {\n",
    "            # Basic summary statistics\n",
    "            'peak_incidence': max(incidence),\n",
    "            'total_cases': sum(incidence),\n",
    "            'attack_rate': sum(incidence) / N,\n",
    "            'final_size': self.r[-1],\n",
    "            'max_infected': max(self.i),\n",
    "            'max_prevalence': max(prevalence),\n",
    "            \n",
    "            # Temporal characteristics\n",
    "            'time_to_peak': np.argmax(incidence),\n",
    "            'epidemic_duration': len([x for x in incidence[1:] if x > 0]),\n",
    "            'growth_rate': np.log(incidence[3] / incidence[1]) if incidence[1] > 0 and incidence[3] > 0 else 0,\n",
    "            \n",
    "            # Weekly and bi-weekly totals\n",
    "            'cases_week_1': cumulative_cases[6] if len(cumulative_cases) > 6 else cumulative_cases[-1],\n",
    "            'cases_week_2': cumulative_cases[13] if len(cumulative_cases) > 13 else cumulative_cases[-1],\n",
    "            'cases_week_3': cumulative_cases[20] if len(cumulative_cases) > 20 else cumulative_cases[-1],\n",
    "            \n",
    "            # Specific time points (every 3 days)\n",
    "            'incidence_day_3': incidence[3] if len(incidence) > 3 else 0,\n",
    "            'incidence_day_6': incidence[6] if len(incidence) > 6 else 0,\n",
    "            'incidence_day_9': incidence[9] if len(incidence) > 9 else 0,\n",
    "            'incidence_day_12': incidence[12] if len(incidence) > 12 else 0,\n",
    "            'incidence_day_15': incidence[15] if len(incidence) > 15 else 0,\n",
    "            'incidence_day_18': incidence[18] if len(incidence) > 18 else 0,\n",
    "            \n",
    "            # Prevalence at key points\n",
    "            'prevalence_day_5': prevalence[5] if len(prevalence) > 5 else 0,\n",
    "            'prevalence_day_10': prevalence[10] if len(prevalence) > 10 else 0,\n",
    "            'prevalence_day_15': prevalence[15] if len(prevalence) > 15 else 0,\n",
    "            'prevalence_day_20': prevalence[20] if len(prevalence) > 20 else 0,\n",
    "            \n",
    "            # Rate-based features\n",
    "            'peak_growth_rate': max(np.diff(incidence)) if len(incidence) > 1 else 0,\n",
    "            'decline_rate': abs(min(np.diff(incidence[np.argmax(incidence):]))) if len(incidence) > np.argmax(incidence) + 1 else 0,\n",
    "        }\n",
    "        \n",
    "        return outputs\n",
    "\n",
    "# Generate synthetic \"observed\" data with the true parameters\n",
    "beta_true = 1.3\n",
    "gamma_true = 0.5\n",
    "population_size = 10000\n",
    "initial_infected = 100\n",
    "\n",
    "print(f\"🦠 Generating synthetic outbreak data...\")\n",
    "print(f\"True parameters: β={beta_true}, γ={gamma_true}, R₀={beta_true/gamma_true:.2f}\")\n",
    "\n",
    "true_model = SIR(\n",
    "    beta=beta_true,\n",
    "    gamma=gamma_true,\n",
    "    s0=population_size - initial_infected,\n",
    "    i0=initial_infected,\n",
    "    n_days=25,  # Longer simulation for more features\n",
    "    seed=42\n",
    ")\n",
    "\n",
    "true_outputs = true_model.get_comprehensive_outputs()\n",
    "\n",
    "print(f\"Generated {len(true_outputs)} potential features for automatic selection\")\n",
    "print(f\"Peak incidence: {true_outputs['peak_incidence']:.0f}\")\n",
    "print(f\"Total cases: {true_outputs['total_cases']:.0f}\")\n",
    "print(f\"Attack rate: {true_outputs['attack_rate']:.1%}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def comprehensive_sir_simulation(samples: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Comprehensive simulation function that returns all possible features\n",
    "    for automatic feature selection.\n",
    "    \"\"\"\n",
    "    results = []\n",
    "    \n",
    "    for _, row in samples.iterrows():\n",
    "        model = SIR(\n",
    "            beta=row['beta'],\n",
    "            gamma=row['gamma'],\n",
    "            s0=population_size - initial_infected,\n",
    "            i0=initial_infected,\n",
    "            n_days=25\n",
    "        )\n",
    "        \n",
    "        outputs = model.get_comprehensive_outputs()\n",
    "        results.append(outputs)\n",
    "    \n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "# Test the comprehensive simulation\n",
    "test_samples = pd.DataFrame({\n",
    "    'beta': [1.0, 1.5, 2.0],\n",
    "    'gamma': [0.3, 0.5, 0.7]\n",
    "})\n",
    "\n",
    "test_results = comprehensive_sir_simulation(test_samples)\n",
    "print(f\"Comprehensive simulation produces {len(test_results.columns)} features\")\n",
    "print(f\"Feature examples: {list(test_results.columns[:8])}...\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Setup Automatic History Matching\n",
    "\n",
    "We'll create observations for multiple features and let the algorithm automatically select the best ones."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
