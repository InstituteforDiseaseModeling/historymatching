    "print(f\"  Most samples: {best_samples['strategy']} ({best_samples['final_samples']} samples)\")\n",
    "print(f\"  Best β recovery: {best_beta['strategy']} ({best_beta['beta_error']:.1%} error)\")\n",
    "print(f\"  Best γ recovery: {best_gamma['strategy']} ({best_gamma['gamma_error']:.1%} error)\")"
