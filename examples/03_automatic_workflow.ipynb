   "source": [
    "# Create comprehensive observation set\n",
    "# Include uncertainty estimates for each observed feature\n",
    "observations = {\n",
    "    # Summary statistics (high priority)\n",
    "    'peak_incidence': (true_outputs['peak_incidence'], (0.1 * true_outputs['peak_incidence'])**2),\n",
    "    'total_cases': (true_outputs['total_cases'], (0.05 * true_outputs['total_cases'])**2),\n",
    "    'attack_rate': (true_outputs['attack_rate'], (0.02)**2),\n",
    "    'time_to_peak': (true_outputs['time_to_peak'], (1.0)**2),\n",
    "    \n",
    "    # Weekly totals (medium priority)\n",
    "    'cases_week_1': (true_outputs['cases_week_1'], (0.15 * true_outputs['cases_week_1'])**2),\n",
    "    'cases_week_2': (true_outputs['cases_week_2'], (0.1 * true_outputs['cases_week_2'])**2),\n",
    "    'cases_week_3': (true_outputs['cases_week_3'], (0.08 * true_outputs['cases_week_3'])**2),\n",
    "    \n",
    "    # Time series points (lower priority, higher uncertainty)\n",
    "    'incidence_day_3': (true_outputs['incidence_day_3'], (0.2 * max(1, true_outputs['incidence_day_3']))**2),\n",
    "    'incidence_day_6': (true_outputs['incidence_day_6'], (0.15 * max(1, true_outputs['incidence_day_6']))**2),\n",
    "    'incidence_day_9': (true_outputs['incidence_day_9'], (0.12 * max(1, true_outputs['incidence_day_9']))**2),\n",
    "    'incidence_day_12': (true_outputs['incidence_day_12'], (0.12 * max(1, true_outputs['incidence_day_12']))**2),\n",
    "    'incidence_day_15': (true_outputs['incidence_day_15'], (0.15 * max(1, true_outputs['incidence_day_15']))**2),\n",
    "    \n",
    "    # Prevalence measures\n",
    "    'max_prevalence': (true_outputs['max_prevalence'], (0.05)**2),\n",
    "    'prevalence_day_10': (true_outputs['prevalence_day_10'], (0.02)**2),\n",
    "    \n",
    "    # Growth characteristics\n",
    "    'growth_rate': (true_outputs['growth_rate'], (0.1)**2),\n",
    "    'epidemic_duration': (true_outputs['epidemic_duration'], (2.0)**2),\n",
    "}\n",
    "\n",
    "print(f\"📊 Created observation set with {len(observations)} features:\")\n",
    "for i, (feature, (mean, var)) in enumerate(observations.items()):\n",
    "    if i < 8:  # Show first 8\n",
    "        print(f\"  {feature}: {mean:.2f} ± {np.sqrt(var):.2f}\")\n",
    "    elif i == 8:\n",
    "        print(f\"  ... and {len(observations) - 8} more features\")\n",
    "        break"
   ]
