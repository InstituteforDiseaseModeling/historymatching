   "source": [
    "## Automatic Workflow with Different Strategies\n",
    "\n",
    "Let's compare different automatic feature selection strategies."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_automatic_workflow(strategy_name, feature_selection_config, max_iterations=5):\n",
    "    \"\"\"Run automatic workflow with specified feature selection strategy.\"\"\"\n",
    "    \n",
    "    print(f\"\\n🚀 Running automatic workflow: {strategy_name}\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    # Create engine with automatic feature selection\n",
    "    engine = (hm.HistoryMatchingBuilder\n",
    "        .from_data(\n",
    "            parameter_bounds={'beta': (0.5, 3.0), 'gamma': (0.1, 1.0)},\n",
    "            observations=observations\n",
    "        )\n",
    "        .with_sampling_strategy('lhs')\n",
    "        .with_feature_selection(feature_selection_config)\n",
    "        .with_emulator_type('gpr')\n",
    "        .with_samples_per_iteration(600)\n",
    "        .with_max_iterations(max_iterations)\n",
    "        .with_implausibility_threshold(3.0)\n",
    "        .with_oversample_factor(3.0)\n",
    "        .with_random_seed(123)\n",
    "        .build()\n",
    "    )\n",
    "    \n",
    "    engine.set_simulation_function(comprehensive_sir_simulation)\n",
    "    \n",
    "    # Add progress monitoring\n",
    "    def iteration_callback(result):\n",
    "        print(f\"  ✅ Iteration {result.iteration}: {len(result.samples)} samples, \"\n",
    "              f\"features: {result.selected_features}\")\n",
    "    \n",
    "    engine.add_iteration_callback(iteration_callback)\n",
    "    \n",
    "    # Time the execution\n",
    "    start_time = time.time()\n",
    "    \n",
    "    # Run automated workflow\n",
    "    results = engine.run()\n",
    "    \n",
    "    end_time = time.time()\n",
    "    \n",
    "    print(f\"\\n📈 {strategy_name} completed in {end_time - start_time:.1f}s:\")\n",
    "    print(f\"  Iterations: {len(results)}\")\n",
    "    print(f\"  Final samples: {len(results[-1].samples)}\")\n",
    "    print(f\"  Final acceptance rate: {engine.acceptance_rate:.3f}\")\n",
    "    print(f\"  Total emulators trained: {engine.progress.total_emulators_trained}\")\n",
    "    \n",
    "    # Parameter recovery assessment\n",
    "    final_samples = results[-1].samples\n",
    "    beta_error = abs(final_samples['beta'].median() - beta_true) / beta_true\n",
    "    gamma_error = abs(final_samples['gamma'].median() - gamma_true) / gamma_true\n",
    "    \n",
    "    print(f\"  Parameter recovery: β error {beta_error:.1%}, γ error {gamma_error:.1%}\")\n",
    "    \n",
    "    # Feature selection summary\n",
    "    all_features = []\n",
    "    for result in results:\n",
    "        all_features.extend(result.selected_features)\n",
    "    \n",
    "    feature_counts = pd.Series(all_features).value_counts()\n",
    "    print(f\"  Most selected features: {list(feature_counts.head(3).index)}\")\n",
    "    \n",
    "    return {\n",
    "        'strategy': strategy_name,\n",
    "        'engine': engine,\n",
    "        'results': results,\n",
    "        'runtime': end_time - start_time,\n",
    "        'final_samples': len(results[-1].samples),\n",
    "        'beta_error': beta_error,\n",
    "        'gamma_error': gamma_error,\n",
    "        'feature_counts': feature_counts,\n",
    "        'total_emulators': engine.progress.total_emulators_trained\n",
    "    }"
   ]
  },
  {
